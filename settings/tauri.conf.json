{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Typer Settings",
  "version": "0.1.0",
  "identifier": "com.chhunly.typer.settings",
  "build": { "frontendDist": "ui" },
  "app": {
    "withGlobalTauri": true,
    "windows": [{ "title": "Typer Settings", "width": 600, "height": 820, "minWidth": 480, "minHeight": 480, "resizable": true }],
    "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'" }
  },
  "bundle": { "active": false, "icon": ["icons/icon.png", "icons/icon.ico"] }
}
